# ─────────────────────────────────────────────────────────────────────────────
# /srv/kidzpos/.env — Variables d'environnement du backend KidzPOS central.
#
# ⚠ Ce fichier contient des SECRETS. Permissions 600 (chown kidzpos:kidzpos).
# ⚠ JAMAIS commiter ce fichier — seul .env.example va en git.
#
# install.sh copie ce template vers /srv/kidzpos/.env et y injecte DB_PASSWORD.
# Toi tu renseignes le reste avant le premier `systemctl start kidzpos`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domaine public ──────────────────────────────────────────────────────────
# Doit pointer (DNS A record) vers l'IP publique de la VM. Caddy l'utilise pour
# émettre le cert Let's Encrypt et pour la config du virtual host.
DOMAIN=central.tondomaine.com

# ── Profile + identité ──────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=central
KIDZPOS_NODE_ID=central
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1            # loopback : seul Caddy y accède

# ── Base de données (injecté par install.sh, ne pas toucher manuellement) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kidzpos_central
DB_USER=kidzpos
DB_PASSWORD=  # ← rempli par install.sh à la création

# ── Secrets — REMPLIR avant démarrage ──────────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET=

# Mot de passe initial du compte admin@kidzpos.com (seulement à la création
# d'une DB vide ; sans effet sur une base existante).
KIDZPOS_ADMIN_PASSWORD=

# Clé d'auth server-to-server pour les push/pull des stores.
# DEUX MODES :
#   Vide  → mode per-store. Chaque store reçoit sa propre clé via
#           POST /api/sync/keys (cf README § Provisionner un store).
#   Non vide → mode legacy : TOUS les stores partagent cette unique clé.
# Recommandé en prod multi-store : laisser VIDE et utiliser per-store.
KIDZPOS_SYNC_INBOUND_API_KEY=

# ── Cookies (HTTPS prod = Secure obligatoire) ──────────────────────────────
KIDZPOS_AUTH_COOKIE_NAME=kidzpos_rt_central
KIDZPOS_AUTH_COOKIE_SAME_SITE=Lax
KIDZPOS_AUTH_COOKIE_SECURE=true

# ── CORS : même origine (Caddy sert front+API) donc rien à autoriser ──────
# Garde uniquement le loopback pour les sondes/cron internes.
CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# ── Inbox processor (matérialise les events poussés par les stores) ────────
KIDZPOS_SYNC_INBOX_ENABLED=true
KIDZPOS_SYNC_INBOX_INTERVAL_MS=5000

# ── Debug : décommenter UNIQUEMENT en cas de souci, jamais en prod ────────
# KIDZPOS_DEBUG_ENABLED=true
# LOGGING_LEVEL_COM_KIDZPOS=DEBUG
