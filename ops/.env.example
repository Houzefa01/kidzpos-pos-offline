# ops/.env.example — copier en ops/.env et adapter avant `docker compose up`.
#
# Toutes les variables sont OPTIONNELLES sauf Telegram (alertmanager-bot
# refuse de démarrer sans TELEGRAM_TOKEN + TELEGRAM_ADMIN — c'est un choix
# pour éviter qu'un déploiement parte sans canal d'astreinte fonctionnel).

# ──── Grafana ────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin    # CHANGER en prod

# ──── Postgres (lu par postgres-exporter ET pg_backup.sh) ────
PG_HOST=localhost
PG_PORT=5432
PG_DB=kidzpos
PG_USER=kidzpos
PG_PASSWORD=kidzpos

# ──── Backup ────
# BACKUP_DIR=/home/<user>/Bureau/sync-till-genius-main/backups
BACKUP_RETENTION_DAYS=7

# ──── Backup off-site (T8 — CRITIQUE en prod) ────
# Sans réplication off-site, un crash disque du store = perte définitive de
# toutes les ventes depuis le dernier push central réussi (souvent < 30s, mais
# peut s'élever à plusieurs heures si lag).
#
# Backends supportés par ops/backup/offsite_sync.sh :
#   rsync   — vers un host SSH (NAS, autre serveur)
#   rclone  — vers un remote S3/B2/GCS/etc. (cf https://rclone.org/)
#   local   — vers un point de montage (USB, NFS, /mnt/nas)
#
# Vide → off-site désactivé (script exit 0 silencieux, alerte
# OffsiteBackupMissing après 24h).
# BACKUP_OFFSITE_KIND=rsync
# BACKUP_OFFSITE_DEST=backup@nas.local:/volume1/kidzpos/store-s1/
# BACKUP_OFFSITE_RSYNC_OPTS="-e 'ssh -i /home/kidzpos/.ssh/backup_key'"
# BACKUP_OFFSITE_RCLONE_FLAGS="--bwlimit 5M"

# ──── Test restore (T9) ────
# Port libre pour le Postgres jetable lancé par test_restore.sh.
# RESTORE_TEST_PORT=55432
# RESTORE_DRIFT_TOLERANCE_PCT=5            # tolère drift prod vs restore (en %)
# RESTORE_TEST_PG_IMAGE=postgres:15-alpine # même version que la prod

# ──── Textfile collector node_exporter (métriques cron) ────
# Si node_exporter monte un volume avec --collector.textfile.directory=...,
# les scripts offsite_sync.sh et test_restore.sh exposent leurs métriques ici.
# TEXTFILE_COLLECTOR_DIR=/var/lib/prometheus/textfile

# ──── Telegram (alertmanager-bot) ────
# 1. Créer le bot via Telegram :
#      Ouvrir une conversation avec @BotFather, taper /newbot, suivre les
#      instructions. Le token ressemble à 1234567890:ABCdefGHIjklMNOpqrSTUv...
#
# 2. Récupérer ton chat_id :
#    Option A — @userinfobot : ouvrir conversation avec @userinfobot,
#               il répond avec ton ID utilisateur (= chat_id pour 1-to-1).
#    Option B — getUpdates API : après avoir envoyé un message au bot,
#               curl "https://api.telegram.org/bot$TELEGRAM_TOKEN/getUpdates"
#               → chercher "message":{"chat":{"id":123456789, ...}}
#
# 3. Mettre les valeurs ci-dessous, puis :
#       docker compose -f ops/docker-compose.yml up -d alertmanager-bot
#    Côté Telegram, envoyer /start au bot pour t'enregistrer.
#
# TELEGRAM_ADMIN peut être 1 ou plusieurs chat_ids séparés par virgule
# (autorise plusieurs opérateurs à /start). Les alertes vont à TOUS les
# chat_ids qui se sont enregistrés via /start.

TELEGRAM_TOKEN=
TELEGRAM_ADMIN=
