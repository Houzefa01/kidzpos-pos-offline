# .env.example — copier en .env et adapter selon votre déploiement.
# Toutes les variables sont OPTIONNELLES (les valeurs commentées sont les défauts).
# Utilisé par ./start-server.sh

# ──── Base de données (PostgreSQL — obligatoire) ────
# Le backend refuse de démarrer sans une PostgreSQL joignable.
# Setup : voir backend/README.md § 2.1.
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=kidzpos
#DB_USER=kidzpos
#DB_PASSWORD=changeme

# ──── Sécurité JWT ────
# CRITIQUE en prod : générer une chaîne aléatoire de 32+ caractères.
#   openssl rand -base64 48
# Si vide, le script en génère une au démarrage (les tokens invalidés à chaque restart).
#JWT_SECRET=

# ──── Mots de passe initiaux ────
# Utilisés UNIQUEMENT si la DB est vide au 1er démarrage.
# À changer immédiatement après première connexion.
#KIDZPOS_ADMIN_PASSWORD=admin123
#KIDZPOS_SARAH_PASSWORD=sarah123
#KIDZPOS_KARIM_PASSWORD=karim123

# ──── Réseau ────
# Port du backend (API + SSE)
#SERVER_PORT=8080

# Port du frontend statique (SPA)
#FRONTEND_PORT=3000

# IP LAN à exposer aux caisses (auto-détectée si vide via `ip -4 addr`)
# Forcer si la machine a plusieurs interfaces réseau.
#LAN_IP=192.168.1.20

# CORS : auto-rempli avec ${LAN_IP}:${FRONTEND_PORT} + plages LAN privées
# (192.168.*.*, 10.*.*.*, 172.16-31.*.*).
# Si HTTPS via Caddy/nginx en prod : forcer la valeur exacte.
#CORS_ALLOWED_ORIGINS=https://kidzpos.monshop.com

# ──── Rate limiting (T5) ────
# Calibrable sans recompile. Defaults sûrs pour LAN mono-backend.
# Augmenter en multi-caisses ou si on déploie un script de test.
#KIDZPOS_RATELIMIT_LOGIN_LIMIT=5
#KIDZPOS_RATELIMIT_LOGIN_WINDOW_MS=300000        # 5 min
#KIDZPOS_RATELIMIT_REFRESH_LIMIT=10
#KIDZPOS_RATELIMIT_REFRESH_WINDOW_MS=60000       # 1 min
#KIDZPOS_RATELIMIT_SYNC_LIMIT=120
#KIDZPOS_RATELIMIT_SYNC_WINDOW_MS=60000          # 1 min
